# Public URL of the deployed store (no trailing slash). Used for PeptidePay success/cancel/webhook URLs.
SITE_URL=https://shop.lbaminos.com

# ---- PeptidePay ----
# REQUIRED for wallet-only mode: your 0x EVM address (receives on Ethereum and Polygon).
PEPTIDEPAY_WALLET=0x0000000000000000000000000000000000000000
# Optional, advanced mode. MUST start with sk_live_ (sk_test_ only works on PeptidePay's webhook simulator).
PEPTIDEPAY_API_KEY=
# REQUIRED: whsec_... from peptide-pay.com/app/api-keys, used for HMAC verification of webhooks.
PEPTIDEPAY_WEBHOOK_SECRET=
# Optional override if PeptidePay changes host (e.g. https://www.peptide-pay.com).
PEPTIDEPAY_API_BASE=https://peptide-pay.com

# ---- Store ----
# Keep false until prices in lib/catalog.js are real and the PeptidePay smoke test passes.
CHECKOUT_ENABLED=false
# Password for /admin (user name can be anything).
ADMIN_PASSWORD=
# Where the SQLite database lives. On Railway, attach a volume and point this at it (e.g. /data).
DATA_DIR=./data
CONTACT_EMAIL=antwest2727@gmail.com
CONTACT_PHONE=(310) 810-2013
