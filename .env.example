# Public URL of the deployed store (no trailing slash).
SITE_URL=https://lbaminos.com

# ---- Payments (manual) ----
# Customers pick Card, Zelle, Cash App or Venmo at checkout. Card buyers get a Stripe payment link
# that you paste on the order in /admin. Leave a handle blank and the order page says "we'll text you our details".
ZELLE_HANDLE=
# Name the customer sees in their bank app for your Zelle (helps them trust the payee).
ZELLE_NAME=
# Your $cashtag (with or without the $).
CASHAPP_HANDLE=
# Your Venmo username (with or without the @).
VENMO_HANDLE=
# Hours you promise to reply with a card link / payment details.
PAYMENT_REPLY_HOURS=12

# ---- Phone alerts ----
# New-order push notifications via the free ntfy app (ntfy.sh). Subscribe to this topic in the app.
# Use a long random name: anyone who knows it can read the alerts. Blank = no alerts.
NTFY_TOPIC=

# ---- Store ----
# Keep false until prices in lib/catalog.js are real.
CHECKOUT_ENABLED=false
# Password for /admin (user name can be anything).
ADMIN_PASSWORD=
# Where the SQLite database lives. On Railway, attach a volume and point this at it (e.g. /data).
DATA_DIR=./data
CONTACT_EMAIL=antwest2727@gmail.com
CONTACT_PHONE=(310) 810-2013
